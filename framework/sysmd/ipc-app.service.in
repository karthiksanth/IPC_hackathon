[Unit]
Description=@SERVICE_DESCRIPTION@
Requires=ipc-token-gen.service @EXTRA_DEPENDENCIES@
After=ipc-token-gen.service @EXTRA_DEPENDENCIES@

[Service]
Type=simple
User=@SERVICE_USER@
Group=ipc_group
EnvironmentFile=/run/ipc_secrets

# --- DEMO MODE: EXECUTING DIRECTLY FROM BUILD FOLDER ---
# CMake will replace this with the absolute path to your local build directory
ExecStart=@CMAKE_CURRENT_BINARY_DIR@/@EXECUTABLE_NAME@

Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target